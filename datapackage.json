{
  "name": "thai-auto-data",
  "title": "Thailand new vehicle registrations and car prices (open data)",
  "description": "Monthly new vehicle registrations in Thailand (DLT categories RY1-RY3) by brand, model, province and fuel type from 2021-01 to 2026-09, from the Department of Land Transport, with prices from official manufacturer websites. Registrations, not sales. Missing data is left empty, never 0.",
  "homepage": "https://github.com/sunJirapath/thai-auto-data",
  "version": "2026-09",
  "keywords": [
    "Thailand",
    "car registrations",
    "car sales",
    "automotive",
    "electric vehicles",
    "EV",
    "market share",
    "car prices",
    "open data",
    "DLT"
  ],
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "path": "https://creativecommons.org/licenses/by/4.0/",
      "title": "Creative Commons Attribution 4.0"
    }
  ],
  "sources": [
    {
      "title": "Department of Land Transport, Thailand: new vehicle registration statistics",
      "path": "https://web.dlt.go.th/statistics/"
    },
    {
      "title": "Department of Provincial Administration: population statistics",
      "path": "https://catalog.dopa.go.th/"
    }
  ],
  "contributors": [
    {
      "title": "sunJirapath",
      "role": "author",
      "path": "https://github.com/sunJirapath"
    }
  ],
  "temporal": {
    "start": "2021-01",
    "end": "2026-09"
  },
  "resources": [
    {
      "name": "market-monthly",
      "path": "summaries/market_monthly.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "description": "Monthly totals by category with MoM and YoY",
      "schema": {
        "fields": [
          {
            "name": "period",
            "type": "string",
            "description": "Month as YYYY-MM (Gregorian)"
          },
          {
            "name": "status",
            "type": "string",
            "description": "Row status"
          },
          {
            "name": "ry1",
            "type": "integer",
            "description": "RY1 registrations"
          },
          {
            "name": "ry2",
            "type": "integer",
            "description": "RY2 registrations"
          },
          {
            "name": "ry3",
            "type": "integer",
            "description": "RY3 registrations"
          },
          {
            "name": "total",
            "type": "integer",
            "description": "RY1+RY2+RY3 registrations"
          },
          {
            "name": "unmatched_model_units",
            "type": "integer",
            "description": "Units whose DLT model name is not matched to a model_id"
          },
          {
            "name": "mom_pct",
            "type": "number",
            "description": "Change vs the previous month, percent; empty if not comparable"
          },
          {
            "name": "yoy_pct",
            "type": "number",
            "description": "Change vs the same month last year, percent; empty if not comparable"
          },
          {
            "name": "source_id",
            "type": "string",
            "description": "Source ID, see data/sources.csv"
          },
          {
            "name": "note",
            "type": "string",
            "description": "Free-text note"
          }
        ]
      }
    },
